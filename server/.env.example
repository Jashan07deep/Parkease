# Copy this file to .env and fill in your values. .env is git-ignored.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=parkease_db

# PIN used to unlock the "Manage spots" admin tools in the app
ADMIN_PIN=change-me

# Allowed browser origin for the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
